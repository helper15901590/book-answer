# ===== 运行时 =====
NODE_ENV="production"
PORT="3000"
DATA_DIR="./data"
APP_ORIGIN="http://localhost:3000"
# 32 字节随机密钥：openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# compose 端口映射宿主端口；仅监听回环，生产建议只通过 Caddy 暴露
HOST_PORT="3000"
# 有 Caddy 反代时保持 127.0.0.1；无域名直连时改为 0.0.0.0 才能从公网访问
BIND_ADDRESS="0.0.0.0"
# 仅在 Caddy/Nginx 等反向代理之后设为 1；直连（公网 IP:端口）时必须为 0 或留空，
# 否则客户端可伪造 X-Forwarded-For 绕过限流并污染审计 IP。
TRUST_PROXY="0"

# 无 HTTPS 直连（内测阶段无域名时使用）：设为 1 会关闭 Cookie Secure、
# CSP upgrade-insecure-requests 与 HSTS，否则浏览器会白屏或丢弃登录态。
# 正式上线配好 HTTPS 后必须删除或设为 0。
ALLOW_INSECURE_HTTP="1"

# ===== 管理员（管理员不入库） =====
ADMIN_PHONE=""
# 至少 16 字符且必须同时包含字母和数字；登录仅校验手机号 + 密码
ADMIN_PASSWORD=""

# ===== LLM（OpenAI 兼容接口，推荐登录后台「LLM 配置」填写） =====
# 注意：后台保存的值优先于这里的环境变量，且首次启动会写入默认的 DeepSeek 地址与模型，
# 因此改用阿里 DashScope 时必须在后台把 API 地址与模型一起改掉，只改这里不生效。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# ===== 外部运维（按需配置，上线前必须完成验证） =====
SENTRY_DSN=""
APP_VERSION=""
HEALTHCHECK_PING_URL=""
RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""