# ===== 运行时 =====
NODE_ENV="production"
PORT="3000"
DATA_DIR="./data"
APP_ORIGIN="https://your-domain.example"
# 32 字节随机密钥：openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# compose 端口映射宿主端口；仅监听回环，生产建议只通过 Caddy 暴露
HOST_PORT="3000"
BIND_ADDRESS="127.0.0.1"
TRUST_PROXY="1"

# ===== 管理员（管理员不入库） =====
ADMIN_PHONE=""
# 至少 16 字符且必须同时包含字母和数字；首次登录后绑定 TOTP
ADMIN_PASSWORD=""

# ===== LLM（OpenAI 兼容接口，也可登录后台配置） =====
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# ===== 外部运维（按需配置，上线前必须完成验证） =====
SENTRY_DSN=""
APP_VERSION=""
HEALTHCHECK_PING_URL=""
RESTIC_REPOSITORY=""
RESTIC_PASSWORD=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""