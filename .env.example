# GEMINI_API_KEY: Server-side API key for Google Gemini fallback and reasoning models.
GEMINI_API_KEY=""

# DEEPSEEK_API_KEY: Required for DeepSeek / OpenAI-compatible model API calls.
DEEPSEEK_API_KEY=""

# DEEPSEEK_BASE_URL: Custom endpoint URL (e.g. https://api.deepseek.com or custom proxy)
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# DEEPSEEK_MODEL: Default model name (e.g. deepseek-chat, deepseek-reasoner)
DEEPSEEK_MODEL="deepseek-chat"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

