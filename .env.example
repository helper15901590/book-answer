# ===== 运行时 =====
NODE_ENV="production"
PORT="3000"
DATA_DIR="./data"
# compose 端口映射 ${HOST_PORT:-3000}:3000 的宿主端口。注意：compose 变量插值读取的是
# docker/ 目录下的 .env 或 shell 环境变量，而非项目根 .env（部署文档 T18 会详述）
HOST_PORT="3000"
# 生产环境必填（≥16字符），缺失将拒绝启动
JWT_SECRET=""
# 管理员种子账号（首次启动创建；缺省 13900000000 + 随机6位密码打印至日志）
ADMIN_PHONE=""
ADMIN_PASSWORD=""
# 仅 Caddy 反代（compose https profile）时置 1：使 express-rate-limit 以 X-Forwarded-For 计客户端 IP；
# 直连部署严禁开启，否则客户端可伪造该头绕过限流。默认 0
TRUST_PROXY="0"

# ===== LLM（也可由管理员登录后在后台 /admin 配置，存于数据库） =====
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"
# 备用别名：主键（DEEPSEEK_API_KEY 等）缺失时由 chat.ts/questions.ts 回退读取
OPENAI_API_KEY=""
