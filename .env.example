# ===== 运行时 =====
NODE_ENV="production"
PORT="3000"
DATA_DIR="./data"
# compose 端口映射 ${HOST_PORT:-3000}:3000 的宿主端口。注意：compose 变量插值读取的是
# docker/ 目录下的 .env 或 shell 环境变量，而非项目根 .env（部署文档 T18 会详述）
HOST_PORT="3000"
# 生产环境必填（≥16字符），缺失将拒绝启动
JWT_SECRET=""
# 管理后台登录凭证（账号不入库，/api/admin/login 直接比对；密码必须为6位数字，前台登录对该手机号按「账号不存在」处理）
ADMIN_PHONE=""
ADMIN_PASSWORD=""
# 仅 Caddy 反代（compose https profile）时置 1：使 express-rate-limit 以 X-Forwarded-For 计客户端 IP；
# 直连部署严禁开启，否则客户端可伪造该头绕过限流。默认 0
TRUST_PROXY="0"

# ===== LLM（OpenAI 兼容接口单路径，二选一；也可留空由管理员登录后在后台 /admin 配置，存于数据库且优先级更高） =====
# 方式一 DeepSeek：   DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"                            DEEPSEEK_MODEL="deepseek-chat"
# 方式二 阿里云百炼： DEEPSEEK_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"      DEEPSEEK_MODEL="qwen-max"（或 qwen-plus 等）
# 未配置有效密钥时聊天接口返回 503 明确报错（无离线模板兜底）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"
