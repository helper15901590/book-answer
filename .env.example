# 本地开发环境变量模板：复制为 .env.local 后按需填写。
# （.gitignore 已排除 .env*，仅放行本文件本身；生产环境模板见 docker/.env.example）
# 服务端按 .env.local → .env 的顺序读取（server/config.ts）。

# 浏览器实际访问的站点地址（协议 + 域名 + 端口，不含路径）。
# CSRF 来源校验与 Cookie 行为都依赖它，写错会导致所有写请求被拒。
APP_ORIGIN="http://localhost:3000"

# 32 字节随机密钥，用于加密存储 LLM API Key 与管理员 TOTP 密钥。
# 生成：openssl rand -base64 32（也接受 64 位 hex）。缺失时拒绝启动。
APP_ENCRYPTION_KEY=""

# 管理员账号（不落库，全部来自环境变量）。
# 生产要求密码至少 16 位且含字母和数字；本地开发允许放宽（启动时仅告警）。
ADMIN_PHONE="13800000000"
ADMIN_PASSWORD="AdminPass12345678!"

# 可选：LLM 上游（OpenAI 兼容接口，默认 DeepSeek）。
# 也可以不填，首次登录后台后在「模型配置」里填写——后台保存的值优先于这里。
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# DEEPSEEK_MODEL="deepseek-chat"

# 可选：服务端口与数据目录（默认 3000 与 ./data）。
# PORT="3000"
# DATA_DIR="./data"
